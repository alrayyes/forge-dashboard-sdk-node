{
  "name": "@forge-dashboard/sdk-node",
  "version": "6.5.0",
  "description": "Node/TypeScript client for forge-dashboard's REST API, generated from its OpenAPI spec.",
  "homepage": "https://github.com/alrayyes/forge-dashboard-sdk-node",
  "bugs": "https://github.com/alrayyes/forge-dashboard-sdk-node/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alrayyes/forge-dashboard-sdk-node.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "docs": "typedoc",
    "generate": "openapi-typescript openapi/openapi.yaml -o src/generated/schema.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepare": "lefthook install",
    "test": "bun test",
    "test:ci": "bun test --coverage --coverage-reporter=lcov --reporter=junit --reporter-outfile=junit.xml",
    "test:contract": "bun test test/contract",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "qs": "6.16.0",
    "smol-toml": "1.9.0"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@hughescr/stryker-bun-runner": "1.4.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.4",
    "lefthook": "2.1.16",
    "openapi-typescript": "7.13.0",
    "sort-package-json": "4.0.0",
    "typedoc": "0.28.20",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
